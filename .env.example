# URL base da sua instância do Chatwoot (sem barra no final)
CHATWOOT_BASE_URL=https://chatwoot.seudominio.com.br
CHATWOOT_ACCOUNT_ID=1

# Copie em: Chatwoot -> Perfil (canto inferior esquerdo) -> Configurações do Perfil -> Token de Acesso
CHATWOOT_API_TOKEN=COLE_SEU_TOKEN_AQUI

# Opcional (LGPD): restringir atuação a IDs específicos de caixas de entrada separados por vírgula (ex.: 1,2,4)
CHATWOOT_ALLOWED_INBOX_IDS=
